{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel><title>{{ .Site.Title }}</title><link>{{ .Site.BaseURL }}</link><description>{{ .Site.Params.subtitle }}</description><language>fa-IR</language>
<atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml"/>
{{ $pages := slice }}{{ range .Site.RegularPages }}{{ if or (eq .Type "event") (eq .Section "~blog") }}{{ $pages = $pages | append . }}{{ end }}{{ end }}
{{ range first 30 (sort $pages "Date" "desc") }}<item><title>{{ .Title }}</title><link>{{ partial "page-url.html" . | absURL }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Summary | plainify | htmlEscape }}</description></item>{{ end }}
</channel></rss>
